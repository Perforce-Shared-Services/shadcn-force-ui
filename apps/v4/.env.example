NEXT_PUBLIC_V0_URL=https://v0.dev
NEXT_PUBLIC_APP_URL=http://localhost:4000

# [FORCE-UI] Framework preview iframes. Set to "1" to point each framework's
# preview iframe at its local dev server (port derived from apps/v4/registry/frameworks.ts,
# e.g. Vue :3001, Svelte :3002, Ember :3003, Angular :3004) instead of the
# production /preview/{framework}/{name} path.
NEXT_PUBLIC_PREVIEW_DEV_SERVERS=1
# Legacy override: if set, used verbatim as the base URL for every framework's
# preview iframe (overrides NEXT_PUBLIC_PREVIEW_DEV_SERVERS). Prefer the flag above.
# NEXT_PUBLIC_PREVIEW_SERVER_URL=http://localhost:3001