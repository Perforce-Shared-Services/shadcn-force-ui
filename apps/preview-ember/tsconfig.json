{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "paths": {
      "@/ember-ui/*": ["../../packages/registry-ember/ui/*"],
      "@/ember-lib/*": ["../../packages/registry-ember/lib/*"],
      "@/ui/*": ["../../packages/registry-ember/ui/*"],
      "@/lib/*": ["../../packages/registry-ember/lib/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
