{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "useDefineForClassFields": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "types": ["vite/client"],
    "paths": {
      "@/angular-ui/*": ["../../packages/registry-angular/ui/*"],
      "@/lib/*": ["../../packages/registry-angular/lib/*"],
      "@force-ui/preview-shell": ["../../packages/preview-shell/src/preview-shell.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
